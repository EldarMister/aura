PORT=3000
DATABASE_URL=
PGSSL=

# Защита REST-команд реле. Такое же значение укажите в
# EXPO_PUBLIC_RELAY_API_TOKEN при сборке приложения.
RELAY_API_TOKEN=change-me

# Tuya Cloud: ключи Cloud Development project, привязанного к Smart Life.
# Регион используется как резервный, если приложение его не передало:
# eu, eu-west, us, us-east, cn, in или sg.
TUYA_REGION=eu
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Необязательно: резервная конфигурация стола 1. По умолчанию приложение
# может передавать эти параметры из экрана настроек.
TUYA_LOCK_DEVICE_CONFIG=false
TUYA_TABLE_1_DEVICE_ID=
TUYA_TABLE_1_DP_CODE=switch_1

# Только для локального шлюза в той же Wi-Fi сети, где находится реле.
TUYA_TABLE_1_LOCAL_IP=
TUYA_TABLE_1_LOCAL_KEY=
TUYA_TABLE_1_VERSION=3.3
TUYA_TABLE_1_DP_ID=1
