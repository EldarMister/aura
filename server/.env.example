PORT=3000
DATABASE_URL=
PGSSL=

# Защита REST-команд реле. Такое же значение укажите в
# EXPO_PUBLIC_RELAY_API_TOKEN при сборке приложения.
RELAY_API_TOKEN=change-me

# Tuya Cloud: ключи Cloud Development project, привязанного к Smart Life.
# Регион приложения фиксирован на EU.
TUYA_REGION=eu
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Необязательно: при true сервер использует Device ID из строк ниже, а не из приложения.
TUYA_LOCK_DEVICE_CONFIG=false
TUYA_TABLE_1_DEVICE_ID=
TUYA_TABLE_1_DP_CODE=switch_1
TUYA_TABLE_2_DEVICE_ID=
TUYA_TABLE_2_DP_CODE=switch_1
